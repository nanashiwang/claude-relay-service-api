# MySQL（任选其一：DATABASE_URL 或 DB_URL_QUANT）
# 提示：若数据库不存在，应用会在启动时尝试自动创建该库（需账号具备建库权限）
DATABASE_URL="mysql+pymysql://app:app@127.0.0.1:3306/card_platform?charset=utf8mb4"
# DB_URL_QUANT="mysql+pymysql://user:pass@127.0.0.1:3306/card_platform?charset=utf8mb4"

# Auth
JWT_SECRET="please-change-me"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXP_MINUTES="10080"

# App
DEFAULT_CURRENCY="CNY"

# Init admin (scripts/init_db.py)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123456"

# Notifications (WeCom)
PUBLIC_BASE_URL="http://127.0.0.1:8000"
WECOM_WEBHOOK_URL=""

# EPay (502码支付)
EPAY_BASE_URL="https://pay.502k.cn/xpay/epay/"
EPAY_PID=""
EPAY_KEY=""
EPAY_SIGN_TYPE="MD5"
# Optional: override callback URLs
# EPAY_NOTIFY_URL="https://your-domain.com/api/v1/payments/notify/epay"
# EPAY_RETURN_URL="https://your-domain.com/web/shop.html?epay_order_no={order_no}"
